{
  "manifestVersion": 5,
  "id": "design.petermatra.photoshop.icc-gamut-inspector",
  "name": "ICC / Gamut Inspector",
  "version": "0.1.5",
  "main": "index.html",
  "host": [{"app": "PS", "minVersion": "28.0.0"}],
  "entrypoints": [{
    "type": "panel", "id": "iccInspector", "label": {"default": "ICC / Gamut Inspector"},
    "minimumSize": {"width": 360, "height": 520},
    "maximumSize": {"width": 4000, "height": 3000},
    "preferredDockedSize": {"width": 400, "height": 760},
    "preferredFloatingSize": {"width": 480, "height": 850}
  }],
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {"domains": ["https://api.github.com"]},
    "webview": {"allow": "yes", "domains": [], "allowLocalRendering": "yes", "enableMessageBridge": "localOnly"}
  }
}
